#include <windows.h>
#include "version.rcinc"

1 ICON "nebula.ico"
1 24 "app.manifest"

1 VERSIONINFO
 FILEVERSION NEBULA_RC_FILEVERSION
 PRODUCTVERSION NEBULA_RC_FILEVERSION
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Nebula"
            VALUE "FileDescription", "Nebula Media - Gestor multimedia y editor de audio"
            VALUE "FileVersion", NEBULA_RC_VERSION_STR
            VALUE "InternalName", "NebulaMedia"
            VALUE "LegalCopyright", "Copyright (C) 2026 Nebula"
            VALUE "OriginalFilename", "NebulaMedia.exe"
            VALUE "ProductName", "Nebula Media"
            VALUE "ProductVersion", NEBULA_RC_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
